<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= appName %></title>
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<header class="topbar no-print">
  <a class="brand" href="/"><span class="mark">LKR</span> <%= appName %></a>
  <% if (user) { %>
  <nav>
    <a href="/">Returns</a>
    <% if (user.role === 'admin') { %><a href="/admin/users">Users</a><% } %>
    <span class="who"><%= user.name %></span>
    <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Sign out</button></form>
  </nav>
  <% } %>
</header>
<% if (flash) { %><div class="flash <%= flash.type %> no-print"><%= flash.msg %></div><% } %>
