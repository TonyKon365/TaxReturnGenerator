PORT=3000
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Set true when served over HTTPS (behind nginx / Caddy)
COOKIE_SECURE=false
# Where the SQLite DB and uploaded files live (back this folder up)
DATA_DIR=./data
# false = only admins can create accounts (the very first account can always register and becomes admin)
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=15
APP_NAME=IRD Tax Filing Portal
# Optional: enables "Read with AI" on uploaded PDFs/images
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
